    {
      "pandal_id": "P112",
      "name": "Naktala Udayan Sangha",
      "facebook_page": "https://facebook.com/p/Naktala-Udayan-Sangha-100064769104330",
      "facebook_verified": true,
      "latest_update": "নাকতলা উদয়ন সংঘের এবারের পুজো-ভাবনা ‘কালধ্বনি’। আগামী ১০ ও ১১ অক্টোবর, সন্ধ্যা ৬টা থেকে রাত ১১টা আমরা মণ্ডপ খোলা রাখছি ব্লগার ও ইউটিউবার বন্ধুদের জন্য। তাঁরা যাতে নির্বিঘ্নে আমাদের মণ্ডপসজ্জার ছবি-ভিডিও তুলতে পারেন, তাই এই ব্যবস্থা। আমাদের পুজোমণ্ডপ সকল দর্শনার্থীদের জন্য উন্মুক্ত হবে ১৩ অক্টোবর, সন্ধ্যা ৭টা থেকে। #DurgaPuja #DurgaPujo #KolkataDurgaPuja #KolkataDurgotsav #KolkataPujo #MaaAshche #Sharodiya #Pujo2026 #NaktalaUdayanSangha",
